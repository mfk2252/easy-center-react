rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // دوال مساعدة
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    // [بند 3] مالك المنصة: لا نكتفي بمطابقة الإيميل، بل نتحقق من طريقة الدخول.
    // - حسابا Gmail: يجب أن يكون الدخول عبر Google والإيميل موثّقاً
    //   (فلا يستطيع أحد إنشاء حساب Email/Password بنفس الإيميل ويصبح مالكاً).
    // - الحساب الداخلي admin.owner@easycenter.local: دخول بكلمة مرور فقط.
    function isPlatformAdmin() {
      return isSignedIn() && (
        (
          request.auth.token.firebase.sign_in_provider == 'google.com' &&
          request.auth.token.email_verified == true &&
          request.auth.token.email in ['mfk2252@gmail.com', 'mfekry225@gmail.com']
        ) ||
        request.auth.uid == 'jebFuJKEFBOYjd864sgtXPIEoY43'
      );
    }

    // مدير المركز صاحب الوثيقة (UID يطابق centerId)
    function isCenterManager(centerId) {
      return isSignedIn() && request.auth.uid == centerId;
    }

    // موظف/ولي أمر نشط تابع لهذا المركز
    function isCenterStaff(centerId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.centerId == centerId &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active != false;
    }

    function staffRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // ===============================================================
    // [بند 2] تصنيف المجموعات حسب الحساسية
    // ===============================================================
    // مالية ورواتب: مدير المركز فقط
    function isStrictManagerCol(c) {
      return c in ['salaries', 'income', 'expenses', 'invoices', 'financialAccounts', 'bonuses'];
    }
    // إنذارات الموظفين: المدير ونائبه
    function isManagerViceCol(c) {
      return c in ['warnings'];
    }
    // رسوم ودفعات الطلاب: المدير ونائبه والاستقبال والسكرتارية
    function isFeesCol(c) {
      return c in ['studentFees', 'payments'];
    }
    // ولي الأمر محصور بطفله المربوط في users/{uid}.studentId
    function parentStudentId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('studentId', '');
    }
    function parentCanReadDoc(c, docId) {
      return parentStudentId() != '' && (
        c == 'students' ? docId == parentStudentId() :
        c == 'attStu' ? resource.data.kidId == parentStudentId() :
        c in ['sessions', 'appointments', 'iepGoals', 'stuReports', 'behaviorPlans', 'studentFees', 'payments']
          ? resource.data.stuId == parentStudentId() :
        c in ['centerEvents', 'centerActivities', 'calEvents', 'academicYears', 'centerCalendarConfig']
      );
    }

    function canReadCol(centerId, c, docId) {
      return isPlatformAdmin() || isCenterManager(centerId) || (
        isCenterStaff(centerId) && (
          staffRole() == 'manager' ||
          (
            !isStrictManagerCol(c) && (
              staffRole() == 'parent' ? parentCanReadDoc(c, docId) :
              isManagerViceCol(c) ? staffRole() == 'vice' :
              isFeesCol(c) ? staffRole() in ['vice', 'reception', 'secretary'] :
              true
            )
          )
        )
      );
    }

    function canWriteCol(centerId, c) {
      return isPlatformAdmin() || isCenterManager(centerId) || (
        isCenterStaff(centerId) && (
          staffRole() == 'manager' ||
          (
            !isStrictManagerCol(c) &&
            staffRole() != 'parent' && (
              isManagerViceCol(c) ? staffRole() == 'vice' :
              isFeesCol(c) ? staffRole() in ['vice', 'reception', 'secretary'] :
              c == 'employees' ? staffRole() == 'vice' :
              c == 'leaves' ? staffRole() in ['vice', 'reception', 'secretary'] :
              true
            )
          )
        )
      );
    }

    // [بند 1] إنشاء مركز جديد: يُسمح فقط بفترة تجريبية (أو بلا حقل اشتراك)،
    // بحيث لا يُنشئ المدير مركزه وهو "active" أو بتجربة طويلة.
    function validNewSubscription() {
      return !('subscription' in request.resource.data) || (
        request.resource.data.subscription.status == 'trial' &&
        request.resource.data.subscription.trialExpiry is timestamp &&
        request.resource.data.subscription.trialExpiry <= request.time + duration.value(7, 'd')
      );
    }

    // ===============================================================
    // 1. المراكز وبياناتها (عزل كامل بين المراكز)
    // ===============================================================
    match /centers/{centerId} {
      allow read: if isPlatformAdmin() || isCenterManager(centerId) || isCenterStaff(centerId);

      allow create: if isPlatformAdmin() || (
        isSignedIn() && request.auth.uid == centerId && validNewSubscription()
      );

      // [بند 1] المدير يعدّل بيانات مركزه لكن لا يلمس حقل الاشتراك أبداً
      allow update: if isPlatformAdmin() || (
        isCenterManager(centerId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscription'])
      );

      // [بند 1] الحذف لمالك المنصة فقط (حتى لا يحذف المدير مركزه ويعيد إنشاءه بتجربة جديدة)
      allow delete: if isPlatformAdmin();

      // [بند 2] المجموعات الفرعية حسب الدور
      match /{collection}/{docId} {
        allow read: if canReadCol(centerId, collection, docId);
        allow write: if canWriteCol(centerId, collection);
      }
    }

    // ===============================================================
    // 2. حسابات المستخدمين (users)
    // ===============================================================
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        isPlatformAdmin() ||
        (resource != null && isCenterManager(resource.data.centerId))
      );

      allow create: if isSignedIn() && (
        isPlatformAdmin() ||
        (request.resource.data.centerId != null && isCenterManager(request.resource.data.centerId))
      );

      allow update: if isSignedIn() && (
        isPlatformAdmin() ||
        (
          resource != null &&
          isCenterManager(resource.data.centerId) &&
          request.resource.data.centerId == resource.data.centerId
        ) ||
        (
          request.auth.uid == userId &&
          resource != null &&
          request.resource.data.centerId == resource.data.centerId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['centerId', 'role', 'permissions', 'active'])
        )
      );

      allow delete: if isSignedIn() && (
        isPlatformAdmin() ||
        (resource != null && isCenterManager(resource.data.centerId))
      );
    }

    // ===============================================================
    // 3. فهرس أسماء المستخدمين (قراءة عامة ضرورية لتسجيل الدخول)
    // ===============================================================
    match /staffLoginIndex/{username} {
      allow read: if true;

      allow create: if isSignedIn() && (
        isPlatformAdmin() ||
        (request.resource.data.centerId != null && isCenterManager(request.resource.data.centerId))
      );

      allow update, delete: if isSignedIn() && (
        isPlatformAdmin() ||
        (resource != null && isCenterManager(resource.data.centerId))
      );
    }

    // ===============================================================
    // 4. طلبات التجربة (trialLeads)
    // ===============================================================
    match /trialLeads/{leadId} {
      allow create: if request.resource.data.name is string &&
                       request.resource.data.name.size() > 0 &&
                       request.resource.data.name.size() < 150 &&
                       request.resource.data.status == 'new' &&
                       request.resource.data.get('email', '').size() < 200 &&
                       request.resource.data.get('org', '').size() < 200 &&
                       request.resource.data.get('note', '').size() < 1000;

      allow read, update, delete: if isPlatformAdmin();
    }
  }
}
